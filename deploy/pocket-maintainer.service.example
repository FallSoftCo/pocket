[Unit]
Description=Pocket repository maintainer
After=network-online.target

[Service]
Type=oneshot
Environment=MAINTAINER_CONFIG=%h/.config/pocket-maintainer/config.json
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Adapt node, app, and lock paths; create the private state directory first.
ExecStart=/usr/bin/flock -n %h/.local/share/pocket-maintainer/worker.lock /usr/bin/node %h/.local/share/pocket-maintainer/app/worker.mjs
UMask=0077
NoNewPrivileges=yes
TimeoutStartSec=30min
KillMode=control-group
